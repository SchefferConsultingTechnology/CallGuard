<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- DayNight so XML resources follow the chosen theme; the window background avoids a flash. -->
    <style name="Theme.CallGuard" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Splash: the symbol straight on the theme background, no icon circle (spec 006, U4). -->
    <style name="Theme.CallGuard.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CallGuard</item>
    </style>
</resources>
